# HTTP server
HTTP_ADDRESS=:8080

# PostgreSQL. Never commit production credentials.
DATABASE_URL=postgres://ai_day:ai_day@localhost:5432/ai_day?sslmode=disable

# Authentication mode exposed safely through /api/v1/config/public
AUTH_MODE=phone

# Pricing and logging
CURRENCY=INR
LOG_LEVEL=info
LOG_FORMAT=json

# Backend-only providers, implemented in later phases
SESSION_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MSG91_AUTH_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
OPENAI_API_KEY=

# Comma-separated browser origins allowed to make credentialed API requests.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
