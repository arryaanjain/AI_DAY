# HTTP server
HTTP_ADDRESS=:8080

# PostgreSQL. Never commit production credentials.
DATABASE_URL=postgres://user:pwd@localhost:5432/db_name?sslmode=disable
#migration: migrate -path ./migrations -database "postgres://user:pwd@localhost:5432/db_name?sslmode=disable" up 

# Comma-separated browser origins allowed to make credentialed API requests.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:3000,http://127.0.0.1:3000

# migrations: migrate -path ./migrations -database "postgres://user:pwd@localhost:5432/db_name?sslmode=disable" up

# Development mode: set to false to send actual SMS OTPs via MSG91 provider
DEV_MODE=true

# Authentication mode exposed safely through /api/v1/config/public
AUTH_MODE=phone

# Pricing and logging
CURRENCY=INR
LOG_LEVEL=info
LOG_FORMAT=json

# Storage provider configuration
# Options: disabled, noop, filesystem, minio, s3
STORAGE_PROVIDER=noop
STORAGE_DISABLED=false
FILESYSTEM_BASE_DIR=./storage

# MinIO/S3 storage (used when STORAGE_PROVIDER=minio or s3)
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ai-day
S3_REGION=us-east-1
S3_USE_SSL=false

# Queue provider configuration
QUEUE_PROVIDER=redis
REDIS_ADDR=localhost:6379

# AI provider configuration
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=dall-e-3
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=standard
OPENAI_IMAGE_OUTPUT_FORMAT=png
OPENAI_IMAGE_OUTPUT_REQUIREMENTS=Output requirements: professional comic panel, preserve characters and facial expressions faithfully.
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=
OPENAI_BASE_URL=https://api.openai.com/v1

# Backend-only providers, implemented in later phases
SESSION_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_HEADER_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

